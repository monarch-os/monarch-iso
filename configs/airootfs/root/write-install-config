#!/bin/bash
# Canonical writer for every installer input produced by the interactive
# configurator and bin/monarch-iso-cidata. Source with
# WRITE_INSTALL_CONFIG_LIBRARY_ONLY=true to load the functions without writing;
# the cidata helper keeps the historical source-to-write interface.
#
# Common inputs: username password password_hash full_name email_address
#                hostname timezone keyboard encrypt_installation
# Optional: defer_provisioning, include_preinstalls, MONARCH_RUNTIME_PACKAGE
# Full disk: disk disk_size
# Protected: disk esp_mount_in_target efi_dev root_partition_device root_mapper
#            luks_uuid_json rollback_partitions_json kernel_choice

defer_provisioning=${defer_provisioning:-false}
include_preinstalls=${include_preinstalls:-true}
MONARCH_RUNTIME_PACKAGE=${MONARCH_RUNTIME_PACKAGE:-monarch}

write_install_user_files() {
  echo "$full_name" >user_full_name.txt
  echo "$email_address" >user_email_address.txt

  if $defer_provisioning; then
    cat <<-_EOF_ >user_credentials.json
{
    "users": []
}
_EOF_
    return
  fi

  local password_escaped password_hash_escaped username_escaped
  password_escaped=$(echo -n "$password" | jq -Rsa)
  password_hash_escaped=$(echo -n "$password_hash" | jq -Rsa)
  username_escaped=$(echo -n "$username" | jq -Rsa)

  local credentials_encryption_line=""
  if [[ $encrypt_installation == true ]]; then
    credentials_encryption_line="    \"encryption_password\": $password_escaped,"
  fi

  cat <<-_EOF_ >user_credentials.json
{
$credentials_encryption_line
    "root_enc_password": $password_hash_escaped,
    "users": [
        {
            "enc_password": $password_hash_escaped,
            "groups": [],
            "sudo": true,
            "username": $username_escaped
        }
    ]
}
_EOF_
}

write_full_disk_install_config() {
  local mib gib disk_size_in_mib gpt_backup_reserve
  local boot_partition_start boot_partition_size main_partition_start main_partition_size
  local kernel_choice=${kernel_choice:-linux-cachyos}
  local password_escaped disk_encryption_config=""

  mib=$((1024 * 1024))
  gib=$((mib * 1024))
  disk_size_in_mib=$((disk_size / mib * mib))
  gpt_backup_reserve=$mib
  boot_partition_start=$mib
  boot_partition_size=$((2 * gib))
  main_partition_start=$((boot_partition_size + boot_partition_start))
  main_partition_size=$((disk_size_in_mib - main_partition_start - gpt_backup_reserve))

  if [[ $encrypt_installation == true ]]; then
    local encryption_password_line=""
    if [[ $defer_provisioning != true ]]; then
      password_escaped=$(echo -n "$password" | jq -Rsa)
      encryption_password_line=$',\n            "encryption_password": '"$password_escaped"
    fi
    disk_encryption_config=$(cat <<-_EOF_
,
        "disk_encryption": {
            "encryption_type": "luks",
            "lvm_volumes": [],
            "iter_time": 2000,
            "partitions": [ "8c2c2b92-1070-455d-b76a-56263bab24aa" ]$encryption_password_line
        }
_EOF_
)
  fi

  cat <<-_EOF_ >user_configuration.json
{
    "app_config": null,
    "archinstall-language": "English",
    "auth_config": {},
    "audio_config": { "audio": "pipewire" },
    "bootloader_config": { "bootloader": "Limine", "uki": false, "removable": false },
    "custom_commands": [],
    "monarch_install": {
        "schema_version": 1,
        "mode": "full_disk",
        "defer_provisioning": $defer_provisioning,
        "include_preinstalls": $include_preinstalls,
        "target_mount": "/mnt",
        "boot": {
            "esp_mount": "/boot",
            "esp_path": "/EFI/limine",
            "efi_binary": "limine_x64.efi",
            "enable_fallback": true
        },
        "storage": {
            "kernel": "$kernel_choice"
        }
    },
    "disk_config": {
        "config_type": "default_layout",
        "device_modifications": [
            {
                "device": "$disk",
                "partitions": [
                    {
                        "btrfs": [],
                        "dev_path": null,
                        "flags": [ "boot", "esp" ],
                        "fs_type": "fat32",
                        "mount_options": [],
                        "mountpoint": "/boot",
                        "obj_id": "ea21d3f2-82bb-49cc-ab5d-6f81ae94e18d",
                        "size": {
                            "sector_size": { "unit": "B", "value": 512 },
                            "unit": "B",
                            "value": $boot_partition_size
                        },
                        "start": {
                            "sector_size": { "unit": "B", "value": 512 },
                            "unit": "B",
                            "value": $boot_partition_start
                        },
                        "status": "create",
                        "type": "primary"
                    },
                    {
                        "btrfs": [
                            { "mountpoint": "/", "name": "@" },
                            { "mountpoint": "/home", "name": "@home" },
                            { "mountpoint": "/var/log", "name": "@log" },
                            { "mountpoint": "/var/cache/pacman/pkg", "name": "@pkg" }
                        ],
                        "dev_path": null,
                        "flags": [],
                        "fs_type": "btrfs",
                        "mount_options": [ "compress=zstd" ],
                        "mountpoint": null,
                        "obj_id": "8c2c2b92-1070-455d-b76a-56263bab24aa",
                        "size": {
                            "sector_size": { "unit": "B", "value": 512 },
                            "unit": "B",
                            "value": $main_partition_size
                        },
                        "start": {
                            "sector_size": { "unit": "B", "value": 512 },
                            "unit": "B",
                            "value": $main_partition_start
                        },
                        "status": "create",
                        "type": "primary"
                    }
                ],
                "wipe": true
            }
        ]$disk_encryption_config
    },
    "hostname": "$hostname",
    "kernels": [ "$kernel_choice" ],
    "network_config": { "type": "nm" },
    "ntp": true,
    "parallel_downloads": 8,
    "script": null,
    "services": [],
    "swap": true,
    "timezone": "$timezone",
    "locale_config": {
        "kb_layout": "$keyboard",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US.UTF-8"
    },
    "mirror_config": {
        "custom_repositories": [],
        "custom_servers": [
            {"url": "https://mirror.cachyos.org/repo/\$arch/\$repo"},
            {"url": "https://cdn.cachyos.org/repo/\$arch/\$repo"}
        ],
        "mirror_regions": {},
        "optional_repositories": []
    },
    "packages": [
        "base-devel",
        "git",
        "archlinux-keyring",
        "cachyos-keyring",
        "monarch-keyring",
        "$MONARCH_RUNTIME_PACKAGE"
    ],
    "profile_config": {
        "gfx_driver": null,
        "greeter": null,
        "profile": {}
    },
    "version": "3.0.9"
}
_EOF_
}

write_protected_install_config() {
  cat <<-_EOF_ >user_configuration.json
{
    "app_config": null,
    "archinstall-language": "English",
    "auth_config": {},
    "audio_config": { "audio": "pipewire" },
    "bootloader_config": { "bootloader": "Limine", "uki": false, "removable": false },
    "custom_commands": [],
    "monarch_install": {
        "schema_version": 1,
        "mode": "protected",
        "defer_provisioning": false,
        "include_preinstalls": $include_preinstalls,
        "target_mount": "/mnt",
        "boot": {
            "esp_mount": "$esp_mount_in_target",
            "esp_path": "/EFI/limine",
            "efi_binary": "limine_x64.efi",
            "enable_fallback": false
        },
        "storage": {
            "disk": "$disk",
            "esp_device": "$efi_dev",
            "root_device": "$root_partition_device",
            "root_mapper": "$root_mapper",
            "luks_uuid": $luks_uuid_json,
            "created_partitions": $rollback_partitions_json,
            "kernel": "$kernel_choice"
        }
    },
    "disk_config": {
        "config_type": "pre_mounted_config",
        "mountpoint": "/mnt"
    },
    "hostname": "$hostname",
    "kernels": [ "$kernel_choice" ],
    "network_config": { "type": "nm" },
    "ntp": true,
    "parallel_downloads": 8,
    "script": null,
    "services": [],
    "swap": true,
    "timezone": "$timezone",
    "locale_config": {
        "kb_layout": "$keyboard",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US.UTF-8"
    },
    "mirror_config": {
        "custom_repositories": [],
        "custom_servers": [
            {"url": "https://mirror.cachyos.org/repo/\$arch/\$repo"},
            {"url": "https://cdn.cachyos.org/repo/\$arch/\$repo"}
        ],
        "mirror_regions": {},
        "optional_repositories": []
    },
    "packages": [
        "base-devel",
        "git",
        "archlinux-keyring",
        "cachyos-keyring",
        "monarch-keyring",
        "$MONARCH_RUNTIME_PACKAGE"
    ],
    "profile_config": {
        "gfx_driver": null,
        "greeter": null,
        "profile": {}
    },
    "version": "3.0.9"
}
_EOF_
}

write_full_disk_install_files() {
  write_install_user_files
  write_full_disk_install_config
}

if [[ ${WRITE_INSTALL_CONFIG_LIBRARY_ONLY:-false} != true ]]; then
  write_full_disk_install_files
fi
