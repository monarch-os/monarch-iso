if [[ "$DRY_RUN" == true ]]; then
  clear_logo
  echo
  gum style \
    --border rounded \
    --border-foreground "$MONARCH_PURPLE_DARK" \
    --foreground "$MONARCH_PURPLE_LIGHT" \
    --bold \
    --align center \
    --width $((LOGO_WIDTH - 2)) \
    --padding "0 2" \
    --margin "0 0 1 $((PADDING_LEFT - 1))" \
    "Dry-run complete"

  gum style --foreground "$MONARCH_TEXT_DIM" --padding "0 0 0 $PADDING_LEFT" "Generated files:"
  for f in user_configuration.json user_credentials.json user_full_name.txt user_email_address.txt; do
