#!/bin/bash

DRY_RUN=false
[[ "${1:-}" == "dry" ]] && DRY_RUN=true

if [[ "$DRY_RUN" == true ]]; then
  # Stub monarch helpers for local testing without the ISO environment
  command -v gum >/dev/null || { echo "dry-run requires gum: https://github.com/charmbracelet/gum"; exit 1; }

  TERM_SIZE=$(stty size 2>/dev/null </dev/tty || echo "24 80")
  export TERM_HEIGHT=$(echo "$TERM_SIZE" | cut -d' ' -f1)
  export TERM_WIDTH=$(echo "$TERM_SIZE" | cut -d' ' -f2)

  # Use a minimal inline logo for dry-run
  LOGO_TEXT="███  MONARCH  ███"
  export LOGO_WIDTH=${#LOGO_TEXT}
  export LOGO_HEIGHT=1
  export PADDING_LEFT=$(((TERM_WIDTH - LOGO_WIDTH) / 2))
  export PADDING_LEFT_SPACES=$(printf "%*s" $PADDING_LEFT "")

  clear_logo() {
    printf "\033[H\033[2J"
    gum style --foreground '#8B5CF6' --padding "1 0 0 $PADDING_LEFT" "$LOGO_TEXT"
  }
else
  # Rely on Monarch for styling and error handling
  source "$MONARCH_INSTALL/helpers/all.sh"
fi

# Ensure tzupdate is available for guessing timezone
if [[ "$DRY_RUN" == false ]]; then
  command -v tzupdate >/dev/null || sudo pacman -Sy --noconfirm tzupdate
fi

# -- Monarch brand colors (from monarchlinux.com) --
MONARCH_PURPLE="#8B5CF6"
MONARCH_PURPLE_LIGHT="#A78BFA"
MONARCH_PURPLE_DARK="#7C3AED"
MONARCH_LAVENDER="#C4B5FD"
MONARCH_TEXT="#E0E7FF"
MONARCH_TEXT_DIM="#C7D2FE"
MONARCH_SURFACE="#312E81"
MONARCH_YELLOW="#e0af68"

TOTAL_STEPS=3
CURRENT_STEP=0

abort() {
  gum style "${1:-Aborted installation}"
  echo
  gum style "You can retry later by running: ./.automated_script.sh"
  exit 1
}

step() {
  local step_num="$1"
  local step_title="$2"
  CURRENT_STEP=$step_num

  clear_logo

  # Progress bar — two colors via ANSI escapes (gum style can't do inline multi-color)
  local bar_total=$((LOGO_WIDTH - 12))
  local bar_filled=$((bar_total * step_num / TOTAL_STEPS))
  local bar_empty=$((bar_total - bar_filled))
  local filled=$(printf "%${bar_filled}s" | tr ' ' '━')
  local empty=$(printf "%${bar_empty}s" | tr ' ' '━')

  echo
  printf "%s  \033[38;2;139;92;246m%s/%s  %s\033[38;2;49;46;129m%s\033[0m\n" \
    "$PADDING_LEFT_SPACES" "$step_num" "$TOTAL_STEPS" "$filled" "$empty"

  # Section title
  gum style \
    --border rounded \
    --border-foreground "$MONARCH_PURPLE_DARK" \
    --foreground "$MONARCH_TEXT" \
    --bold \
    --align center \
    --width $((LOGO_WIDTH - 2)) \
    --padding "0 2" \
    --margin "1 0 1 $PADDING_LEFT" \
    "$step_title"
}

notice() {
  clear_logo
  echo
  gum style \
    --border rounded \
    --border-foreground "$MONARCH_PURPLE_DARK" \
    --foreground "$MONARCH_YELLOW" \
    --align center \
    --width $((LOGO_WIDTH - 2)) \
    --padding "0 2" \
    --margin "1 0 0 $PADDING_LEFT" \
    "$1"
  sleep "${2:-2}"
}

welcome_screen() {
  clear_logo
  echo
  gum style \
    --border rounded \
    --border-foreground "$MONARCH_PURPLE_DARK" \
    --align center \
    --width $((LOGO_WIDTH - 2)) \
    --padding "1 4" \
    --margin "0 0 0 $PADDING_LEFT" \
    "$(gum style --foreground "$MONARCH_PURPLE_LIGHT" --bold "Welcome to the Monarch installer")" \
    "" \
    "$(gum style --foreground "$MONARCH_TEXT_DIM" "This will guide you through setting up your system.")" \
    "$(gum style --foreground "$MONARCH_TEXT_DIM" "You can abort at any time with Ctrl+C.")" \
    "" \
    "$(gum style --foreground "$MONARCH_SURFACE" --faint "Press Enter to continue")"
  read -r </dev/tty
}

welcome_screen

