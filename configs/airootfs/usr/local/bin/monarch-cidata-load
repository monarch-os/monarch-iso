#!/bin/bash
#
# Copy the configurator's output files off a cidata drive into /root, so the
# wizard can be skipped. Exit 0 when that happened; anything else means this is
# not an autoinstall drive and the caller falls back to the wizard.
#
# The optional argument prefixes every path touched, so tests can run against a
# sandbox. See AGENTS.md "Autoinstall".

set -uo pipefail

root=${1:-}
by_label=$root/dev/disk/by-label
dest=$root/root
mnt=$root/run/cidata

# On a fast boot this can run before udev has finished enumerating, which would
# silently drop a headless install into the wizard.
udevadm settle 2>/dev/null || true

# mkfs.vfat uppercases the label, genisoimage does not.
device=""
for label in cidata CIDATA; do
  [[ -e $by_label/$label ]] && { device=$by_label/$label; break; }
done
[[ -n $device ]] || exit 1

mkdir -p "$mnt"
mount -o ro "$device" "$mnt" || exit 1

required_inputs=(user_configuration.json user_credentials.json)
optional_inputs=(user_full_name.txt user_email_address.txt authorized_keys)

# A previous load in the same live session may have left inputs behind: a stale
# authorized_keys would authorize keys the current drive never carried. Nothing
# of the user's is lost, since a cidata load always precedes the wizard.
for file in "${required_inputs[@]}" "${optional_inputs[@]}"; do
  rm -f "$dest/$file"
done

loaded=1
if [[ -f $mnt/user_configuration.json && -f $mnt/user_credentials.json ]]; then
  files=()
  for file in "${required_inputs[@]}" "${optional_inputs[@]}"; do
    [[ -f $mnt/$file ]] && files+=("$mnt/$file")
  done

  if cp "${files[@]}" "$dest"/; then
    loaded=0
  else
    # The wizard cleans up only what it writes, so a half-copied drive would
    # leak into the interactive install that follows.
    for file in "${files[@]}"; do
      rm -f "$dest/${file##*/}"
    done
  fi
fi

umount "$mnt"
exit $loaded
