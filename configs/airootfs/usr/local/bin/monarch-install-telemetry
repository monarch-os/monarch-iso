#!/bin/bash

set -euo pipefail

snapshot() {
  local log="$1" state="$2"
  if [[ -s $state ]]; then
    jq -r '
      "[installer-state] phase: \(.current_phase) (\(.current_index + 1)/\(.total_phases))",
      ((.phases // []) | map(select(.status == "failed")) | last // empty
        | "[installer-state] failed: \(.name): \(.error)"),
      (if .finished_at then "[installer-state] complete" else empty end)
    ' "$state" || true
  else
    echo '[installer-state] waiting for the orchestrator'
  fi
  [[ ! -f $log ]] || tail -n 20 "$log"
}

if [[ ${1:-} == "--snapshot" ]]; then
  snapshot "$2" "$3"
  exit 0
fi

port=/dev/virtio-ports/org.monarch.install-status
[[ -c $port ]] || exit 0

while true; do
  snapshot /var/log/monarch-install.log /run/monarch-install/state.json
  sleep 10
done >"$port"
