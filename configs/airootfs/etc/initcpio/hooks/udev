#!/usr/bin/ash
# mkinitcpio's udev hook, with Omarchy's live-medium wait (1cd7462).

run_earlyhook() {
  local quiet
  if command -v '/usr/bin/systemd-tmpfiles' >/dev/null 2>&1; then
    kmod static-nodes --format=tmpfiles --output=/run/tmpfiles.d/kmod.conf
    '/usr/bin/systemd-tmpfiles' --prefix=/dev --create --boot
  fi
  quiet="$(getarg quiet)"
  if [ "${quiet}" = "y" ]; then
    '/usr/lib/systemd/systemd-udevd' --daemon --resolve-names=never >/dev/null 2>&1
  else
    '/usr/lib/systemd/systemd-udevd' --daemon --resolve-names=never
  fi
  # used externally by poll_device()
  # shellcheck disable=SC2034
  udevd_running=1
}

# Ventoy's dmsetup mapping need not have a udev by-uuid link.
wait_for_medium() {
  local tenths=300
  while [ "$tenths" -gt 0 ]; do
    blkid -lt "UUID=$1" -o device >/dev/null 2>&1 && return 0
    sleep 0.1
    tenths=$((tenths - 1))
  done
  return 1
}

run_hook() {
  msg ":: Triggering uevents..."
  udevadm trigger --action=add --type=subsystems
  udevadm trigger --action=add --type=devices
  # Normal mode maps the ISO after these hooks; GRUB2 maps it from uevents.
  if [ -d /ventoy ] && [ "$(getarg rdinit)" != /vtoy/vtoy ]; then
    return 0
  fi
  # PXE attaches its medium later; absent media retain mkinitcpio's settle.
  # shellcheck disable=SC2154
  if [ -n "${archisosearchuuid}" ] &&
    [ -z "${archiso_nbd_srv}${archiso_nfs_srv}${archiso_http_srv}" ] &&
    wait_for_medium "${archisosearchuuid}"; then
    return 0
  fi
  udevadm settle
}

run_cleanuphook() {
  udevadm control --exit
  udevadm info --cleanup-db
}
