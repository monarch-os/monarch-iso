#!/bin/bash

set -e

BOOT_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")

# nproc counts SMT threads, so on an 8-core/16-thread laptop it hands the guest
# every logical CPU and leaves the host nothing to schedule on. Count physical
# cores and keep two for the desktop, so a busy guest cannot wedge the session.
usable_cores() {
  local cores
  cores=$(lscpu -p=CORE 2>/dev/null | grep -v '^#' | sort -u | wc -l)
  [[ $cores =~ ^[0-9]+$ ]] && ((cores > 0)) || cores=$(($(nproc) / 2))
  ((cores > 0)) || cores=1
  ((cores > 2)) && echo $((cores - 2)) || echo 1
}

ISO="$1"
REUSE=""
OFFLINE=""
VM_CPUS="${MONARCH_VM_CPUS:-$(usable_cores)}"
VM_MEMORY="${MONARCH_VM_MEMORY:-4096}"

# The disk lived in /tmp, which is a tmpfs on Arch — a 30G virtual disk was
# therefore backed by RAM, cost gigabytes of it as it filled, and could never
# grow past the tmpfs size regardless of what qemu-img was asked for. vm-saves/
# is gitignored and on real storage.
DISK="${MONARCH_VM_DISK:-$BOOT_ROOT/vm-saves/monarch-iso-boot.qcow2}"
DISK_SIZE="${MONARCH_VM_DISK_SIZE:-30G}"
OVMF_VARS="${DISK%.qcow2}-OVMF_VARS.4m.fd"

for arg in "${@:2}"; do
  case "$arg" in
    reuse) REUSE="reuse" ;;
    offline) OFFLINE="offline" ;;
  esac
done

if [ $# -eq 0 ]; then
  ISO=$(ls -t release/*.iso 2>/dev/null | gum choose --header "Select ISO to boot")
  if gum confirm --default=false "Reuse existing disk?"; then
    REUSE="reuse"
  fi
  if gum confirm --default=false "Boot offline (no network)?"; then
    OFFLINE="offline"
  fi
fi

if [ -z "$ISO" ]; then
  echo "Usage: monarch-iso-boot [release/monarch.iso] [reuse] [offline]"
  echo "  reuse    Reuse existing disk image at $DISK"
  echo "  offline  Boot without any network interface (test offline install)"
  echo "  SSH available at: ssh -p 2222 root@localhost (after installing openssh, online mode only)"
  exit 1
fi

if [ "$OFFLINE" = "offline" ]; then
  NET_ARGS=(-nic none)
else
  NET_ARGS=(
    -netdev user,id=net0,hostfwd=tcp::2222-:22
    -device virtio-net-pci,netdev=net0
  )
fi

if ! pacman -Q qemu-full >/dev/null || ! pacman -Q edk2-ovmf >/dev/null; then
  sudo pacman -S --noconfirm --needed --quiet qemu-full edk2-ovmf
fi

if [[ -z ${WAYLAND_DISPLAY:-} && -z ${DISPLAY:-} ]]; then
  while IFS='=' read -r name value; do
    case "$name" in
    WAYLAND_DISPLAY | DISPLAY | XAUTHORITY | XDG_SESSION_TYPE)
      export "$name=$value"
      ;;
    esac
  done < <(systemctl --user show-environment 2>/dev/null || true)
fi

if [[ -z ${WAYLAND_DISPLAY:-} && -z ${DISPLAY:-} ]]; then
  echo "Unable to find a graphical session for QEMU." >&2
  echo "Run monarch-iso-boot from the Monarch desktop session." >&2
  exit 1
fi

mkdir -p "${DISK%/*}"
if [[ ! -f $DISK || $REUSE != "reuse" ]]; then
  qemu-img create -f qcow2 "$DISK" "$DISK_SIZE"
  cp /usr/share/edk2/x64/OVMF_VARS.4m.fd "$OVMF_VARS"
fi

# Boot from ISO before we've installed, then boot from drive after
qemu-system-x86_64 \
  -cpu host -enable-kvm -machine q35,accel=kvm \
  -smp "$VM_CPUS" \
  -m "$VM_MEMORY" \
  -drive if=pflash,format=raw,readonly=on,file=/usr/share/edk2/x64/OVMF_CODE.4m.fd \
  -drive if=pflash,format=raw,file="$OVMF_VARS" \
  -drive file="$DISK",format=qcow2,if=none,id=drive0 \
  -device virtio-blk-pci,drive=drive0,bootindex=1 \
  -drive file="$ISO",media=cdrom,if=none,format=raw,id=cdrom0 \
  -device ide-cd,drive=cdrom0,bootindex=2 \
  -device virtio-vga-gl \
  -display gtk,gl=on \
  -usb -device usb-tablet \
  -serial none \
  "${NET_ARGS[@]}" \
  -boot menu=on
