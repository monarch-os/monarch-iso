#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VM_DIR="$(dirname "$SCRIPT_DIR")/vm-saves"

# The same disk monarch-iso-boot would use, override included, so `save` with no
# argument snapshots whatever was last booted rather than a guess.
WORK_DISK="${MONARCH_VM_DISK:-$VM_DIR/monarch-iso-boot.qcow2}"

# monarch-iso-boot derives the EFI variables from the disk name, so anything
# handed to it through MONARCH_VM_DISK must keep them under this name.
ovmf_of() {
  echo "${1%.qcow2}-OVMF_VARS.4m.fd"
}

# A snapshot is a directory holding the disk and its variables. Disks saved flat
# beside it still resolve: they are what monarch-iso-boot writes when
# MONARCH_VM_DISK names one, and there is no reason to lose track of them.
disk_of() {
  local dir="$VM_DIR/$1/disk.qcow2"
  [[ -f "$dir" ]] && echo "$dir" || echo "$VM_DIR/$1.qcow2"
}

mkdir -p "$VM_DIR"

save_vm() {
  local name="$1"

  if [[ -z "$name" ]]; then
    name=$(gum input --placeholder "Enter VM snapshot name")
    [[ -z "$name" ]] && exit 1
  fi

  if [[ ! -f "$WORK_DISK" ]]; then
    echo "No disk at $WORK_DISK"
    echo "Boot a VM first with: monarch-iso-boot [iso]"
    exit 1
  fi

  local vm_path="$VM_DIR/$name"
  local disk="$vm_path/disk.qcow2"

  if [[ -f "$VM_DIR/$name.qcow2" ]]; then
    echo "Error: '$name' already names a disk saved flat, from before snapshots"
    echo "had a directory of their own. Move it in, or save under another name:"
    echo "  mkdir -p $vm_path"
    echo "  mv $VM_DIR/$name.qcow2 $disk"
    echo "  mv $(ovmf_of "$VM_DIR/$name") $(ovmf_of "$disk")"
    exit 1
  fi

  if [[ -f "$disk" ]] && ! gum confirm "Snapshot '$name' exists. Overwrite?"; then
    exit 0
  fi

  mkdir -p "$vm_path"

  echo "Saving snapshot '$name'..."
  # --reflink=auto: vm-saves sits on btrfs here, where a 30G image copies
  # instantly and shares its extents until one side is written to.
  cp --reflink=auto "$WORK_DISK" "$disk"
  if [[ -f $(ovmf_of "$WORK_DISK") ]]; then
    cp "$(ovmf_of "$WORK_DISK")" "$(ovmf_of "$disk")"
  fi

  gum style --foreground 212 "✓ Saved to $vm_path"
}

snapshot_names() {
  local path work
  work=$(realpath -m "$WORK_DISK")

  {
    for path in "$VM_DIR"/*/disk.qcow2; do
      [[ -f "$path" ]] || continue
      path=${path%/disk.qcow2}
      basename "$path"
    done

    for path in "$VM_DIR"/*.qcow2; do
      [[ -f "$path" ]] || continue
      [[ $(realpath -m "$path") == "$work" ]] && continue
      basename "$path" .qcow2
    done
  } | sort -u
}

list_vms() {
  local names
  names=$(snapshot_names)

  if [[ -z "$names" ]]; then
    echo "No VM snapshots found"
    return 1
  fi

  echo "Available VM snapshots:"
  local name disk
  while read -r name; do
    disk=$(disk_of "$name")
    printf '  • %s (%s, %s)\n' \
      "$name" "$(du -h "$disk" | cut -f1)" "$(date -r "$disk" '+%Y-%m-%d %H:%M')"
  done <<<"$names"
}

boot_vm() {
  local name="$1"

  if [[ -z "$(snapshot_names)" ]]; then
    echo "No VM snapshots available"
    exit 1
  fi

  if [[ -z "$name" ]]; then
    name=$(snapshot_names | gum choose --header "Select VM to boot:")
    [[ -z "$name" ]] && exit 0
  fi

  local disk
  disk=$(disk_of "$name")

  if [[ ! -f "$disk" ]]; then
    echo "Error: VM '$name' not found"
    list_vms
    exit 1
  fi

  if [[ ! -f $(ovmf_of "$disk") ]]; then
    echo "Error: '$name' has no EFI variables at $(ovmf_of "$disk")"
    echo "Boot it once from an ISO to create them:"
    echo "  MONARCH_VM_DISK=$disk ./bin/monarch-iso-boot release/<iso> reuse"
    exit 1
  fi

  gum style --foreground 212 "✓ Booting '$name' in place — writes land in the snapshot"

  # /dev/null stands in for the ISO: there is nothing to install from, only the
  # disk to boot. `reuse` is what stops monarch-iso-boot from formatting it.
  MONARCH_VM_DISK="$disk" exec monarch-iso-boot /dev/null reuse
}

case "${1:-}" in
  save)
    save_vm "$2"
    ;;
  boot)
    boot_vm "$2"
    ;;
  list)
    list_vms
    ;;
  *)
    gum style --border rounded --padding "0 1" --border-foreground 212 \
      "$(gum style --bold 'monarch-vm') - VM snapshot manager" \
      "" \
      "$(gum style --foreground 245 'Commands:')" \
      "  save [name]  Copy the current disk to vm-saves/<name>/" \
      "  boot [name]  Boot a saved disk (interactive if no name)" \
      "  list         List available VMs" \
      "" \
      "$(gum style --foreground 245 "Current disk: $WORK_DISK")" \
      "$(gum style --foreground 245 'Snapshots:')"
    list_vms 2>/dev/null || echo "  None"
    ;;
esac
