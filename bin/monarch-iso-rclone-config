#!/bin/bash
monarch-pkg-add rclone
mkdir -p ~/.config/rclone

access_key=$(op read "op://Shared/Cloudflare Buckets/iso.monarchlinux.com/access_key_id" --account Monarch)
secret_access_key=$(op read "op://Shared/Cloudflare Buckets/iso.monarchlinux.com/secret_access_key" --account Monarch)
endpoint=$(op read "op://Shared/Cloudflare Buckets/iso.monarchlinux.com/endpoint" --account Monarch)

cat > ~/.config/rclone/rclone.conf << EOF
[Monarch]
type = s3
provider = AWS
access_key_id = $access_key
secret_access_key = $secret_access_key
endpoint = $endpoint
EOF
