#!/bin/bash

if [ $# -eq 0 ]; then
  echo "Usage: monarch-iso-upload [release/monarch.iso]"
  exit 1
fi

if [[ ! -f ~/.config/rclone/rclone.conf ]]; then
  echo "You must first configure rclone with the R2 credentials: monarch-iso-rclone-config"
  exit 1
fi

status=0
rclone copy "$1" Monarch:monarch/ -P || status=1

for sidecar in "$1.sig" "$1.sha256"; do
  if [[ ! -f $sidecar ]]; then
    echo "Required release sidecar missing: $sidecar" >&2
    status=1
    continue
  fi
  rclone copy "$sidecar" Monarch:monarch/ -P || status=1
done

exit $status
